<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_baseline_arrow_back_24"
        app:title="@string/nopatch_title" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_medium"
            android:paddingTop="@dimen/spacing_small"
            android:paddingBottom="@dimen/spacing_large">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/card_radius_large"
                app:cardElevation="@dimen/card_elevation_medium"
                app:cardPreventCornerOverlap="false"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:id="@+id/status_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/gradient_warning"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/status_card_min_height"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/spacing_medium"
                    android:paddingVertical="14dp">

                    <ImageView
                        android:id="@+id/status_icon"
                        android:layout_width="@dimen/status_icon_size"
                        android:layout_height="@dimen/status_icon_size"
                        app:srcCompat="@drawable/ic_round_warning_24"
                        app:tint="@color/text_on_gradient"
                        tools:ignore="ContentDescription" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_medium"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/status_title"
                            style="@style/StatusCardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/status_summary"
                            style="@style/StatusCardSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/grant_notifications"
                style="@style/ModernButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:text="@string/nopatch_grant_notifications"
                app:icon="@drawable/ic_notifications_black_24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/grant_alerts"
                style="@style/ModernButton.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:text="@string/nopatch_grant_alerts"
                app:icon="@drawable/ic_notifications_black_24dp" />

            <com.google.android.material.card.MaterialCardView
                style="@style/CardInfoStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_medium">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_capture"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/nopatch_switch_capture" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_deleted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/nopatch_switch_deleted" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_edited"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/nopatch_switch_edited" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/open_messages"
                style="@style/ModernButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:text="@string/nopatch_open_messages"
                app:icon="@drawable/ic_privacy" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/open_deleted"
                style="@style/ModernButton.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:text="@string/nopatch_open_deleted"
                app:icon="@drawable/ic_delete" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/open_statuses"
                style="@style/ModernButton.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:text="@string/nopatch_open_statuses"
                app:icon="@drawable/ic_image" />

            <com.google.android.material.card.MaterialCardView
                style="@style/CardInfoStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_medium">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/noroot_how_title"
                        android:textAppearance="?textAppearanceTitleSmall" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/nopatch_how_body"
                        android:textAppearance="?textAppearanceBodyMedium" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
